# La maqueta estatica original vive en su propio repositorio (apiqueres/elniu).
# Tenerla aqui dentro como copia de trabajo es comodo, pero no forma parte de
# este proyecto y git la trataria como un submodulo.
/elniu/

# Dependencias y compilados
node_modules/
dist/
target/
.angular/

# La base de datos local de pruebas del backend: lleva reservas con nombres,
# telefonos y correos de personas. Nunca al repositorio.
elniu-api/datos/

# Entornos y secretos: las claves de correo y de la base de datos van en
# variables de entorno del servidor, jamas en un fichero versionado.
.env
*.env

# Editores y sistema
.idea/
*.iml
.DS_Store
Thumbs.db
